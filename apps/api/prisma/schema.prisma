// AttendSure database schema, following docs/DATABASE_SCHEMA.md. Models are added domain by domain.
// Conventions: UUID v7 keys, timestamptz in UTC, snake_case table and column names.
// Constraints Prisma cannot express (partial unique indexes, triggers, checks) live in the migration SQL
// and are listed in docs/DATABASE_SCHEMA.md §4.
// The connection URL lives in prisma.config.ts.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Identity and security ─────────────────────────

enum RoleKey {
  SUPER_ADMIN
  UNIVERSITY_ADMIN
  REGISTRAR
  LECTURER
  STUDENT
  COURSE_REP
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ScopeType {
  INSTITUTION
  FACULTY
  DEPARTMENT
}

enum ClientType {
  WEB
  MOBILE
}

enum TokenPurpose {
  ACTIVATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum DevicePlatform {
  ANDROID
  IOS
}

enum DeviceStatus {
  PENDING_APPROVAL
  TRUSTED
  REVOKED
  REPLACED
}

enum ActorType {
  USER
  SYSTEM
}

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  /// Always stored lower-case (checked by the database).
  email            String     @unique
  phone            String?
  fullName         String     @map("full_name")
  /// Argon2id hash; null until the account is activated.
  passwordHash     String?    @map("password_hash")
  status           UserStatus @default(PENDING_ACTIVATION)
  /// Encrypted TOTP secret for staff roles.
  mfaSecretEnc     String?    @map("mfa_secret_enc")
  mfaEnabledAt     DateTime?  @map("mfa_enabled_at") @db.Timestamptz(3)
  /// TOTP time step of the last accepted code, so a code cannot be used twice.
  mfaLastTimeStep  Int?       @map("mfa_last_time_step")
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles                     UserRole[]                @relation("UserRoleHolder")
  rolesGranted              UserRole[]                @relation("UserRoleGrantedBy")
  rolesRevoked              UserRole[]                @relation("UserRoleRevokedBy")
  authSessions              AuthSession[]
  tokens                    UserToken[]
  devices                   UserDevice[]              @relation("DeviceOwner")
  devicesApproved           UserDevice[]              @relation("DeviceApprovedBy")
  devicesRevoked            UserDevice[]              @relation("DeviceRevokedBy")
  auditLogs                 AuditLog[]
  recoveryCodes             MfaRecoveryCode[]
  calendarExceptionsCreated CalendarException[]       @relation("CalendarExceptionCreatedBy")
  lecturerProfile           LecturerProfile?
  assignmentsMade           LecturerAssignment[]      @relation("AssignmentAssignedBy")
  assignmentsEnded          LecturerAssignment[]      @relation("AssignmentEndedBy")
  studentProfile            StudentProfile?           @relation("StudentUser")
  studentsRegistered        StudentProfile[]          @relation("StudentRegisteredBy")
  studentsVerified          StudentProfile[]          @relation("StudentVerifiedBy")
  filesUploaded             FileObject[]
  importsUploaded           ImportBatch[]             @relation("ImportUploadedBy")
  importsDecided            ImportBatch[]             @relation("ImportDecidedBy")
  enrollmentsCreated        CourseEnrollment[]        @relation("EnrollmentCreatedBy")
  enrollmentsEnded          CourseEnrollment[]        @relation("EnrollmentEndedBy")
  repsNominated             CourseRepAssignment[]     @relation("RepNominatedBy")
  repsAssigned              CourseRepAssignment[]     @relation("RepAssignedBy")
  repsEnded                 CourseRepAssignment[]     @relation("RepEndedBy")
  settingsUpdated           InstitutionSetting[]      @relation("SettingUpdatedBy")
  systemEventsAcknowledged  SystemEvent[]             @relation("SystemEventAcknowledgedBy")
  timetablesPublished       Timetable[]               @relation("TimetablePublishedBy")
  timetablesCreated         Timetable[]               @relation("TimetableCreatedBy")
  timetableEntriesCreated   TimetableEntry[]          @relation("TimetableEntryCreatedBy")
  timetableExceptions       TimetableEntryException[] @relation("TimetableExceptionCreatedBy")
  timetableChanges          TimetableChange[]         @relation("TimetableChangedBy")
  classSessionsCancelled    ClassSession[]            @relation("ClassSessionCancelledBy")
  classEvents               ClassEvent[]              @relation("ClassEventActor")
  rescheduleRequests        RescheduleRequest[]       @relation("RescheduleRequestedBy")
  rescheduleDecisions       RescheduleRequest[]       @relation("RescheduleDecidedBy")
  classIssueReports         ClassIssueReport[]        @relation("IssueReporter")
  classReviewDecisions      ClassStatusReview[]       @relation("ReviewDecidedBy")
  notifications             Notification[]
  notificationPreferences   NotificationPreference[]
  riskFlagReviews           RiskFlag[]                @relation("RiskFlagReviewedBy")
  verificationPolicies      VerificationPolicy[]
  calibrationSurveys        CalibrationSurvey[]       @relation("SurveyedBy")
  calibrationApplications   CalibrationSurvey[]       @relation("SurveyAppliedBy")

  attendanceOpened      AttendanceSession[]    @relation("AttendanceOpenedBy")
  attendanceClosed      AttendanceSession[]    @relation("AttendanceClosedBy")
  attendanceCorrections AttendanceCorrection[] @relation("AttendanceCorrectedBy")

  verificationDecisions VerificationDecision[] @relation("VerificationDecidedBy")

  @@map("users")
}

model Role {
  id          String  @id @default(uuid(7)) @db.Uuid
  key         RoleKey @unique
  name        String
  description String?

  permissions RolePermission[]
  grants      UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid(7)) @db.Uuid
  /// e.g. "attendance.correct"; the catalogue lives in packages/shared.
  key         String  @unique
  description String
  /// Protected permissions may only ever be held by SUPER_ADMIN.
  isProtected Boolean @default(false) @map("is_protected")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// A grant of a role, optionally limited to a faculty or department.
/// Partial unique index (SQL): one active grant per user, role and scope.
model UserRole {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  scopeType   ScopeType @default(INSTITUTION) @map("scope_type")
  /// Faculty.id or Department.id when scoped (foreign keys added with the academic tables).
  scopeId     String?   @map("scope_id") @db.Uuid
  grantedById String    @map("granted_by_id") @db.Uuid
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById String?   @map("revoked_by_id") @db.Uuid

  user      User  @relation("UserRoleHolder", fields: [userId], references: [id])
  role      Role  @relation(fields: [roleId], references: [id])
  grantedBy User  @relation("UserRoleGrantedBy", fields: [grantedById], references: [id])
  revokedBy User? @relation("UserRoleRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  @@index([userId])
  @@map("user_roles")
}

/// One signed-in client (a browser or a phone).
model AuthSession {
  id            String     @id @default(uuid(7)) @db.Uuid
  userId        String     @map("user_id") @db.Uuid
  client        ClientType
  deviceId      String?    @map("device_id") @db.Uuid
  activeRoleKey RoleKey?   @map("active_role_key")
  /// Set when the sign-in included a two-step code. Staff roles need it.
  mfaVerifiedAt DateTime?  @map("mfa_verified_at") @db.Timestamptz(3)
  ip            String?
  userAgent     String?    @map("user_agent")
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime   @map("expires_at") @db.Timestamptz(3)
  lastUsedAt    DateTime?  @map("last_used_at") @db.Timestamptz(3)
  revokedAt     DateTime?  @map("revoked_at") @db.Timestamptz(3)
  revokeReason  String?    @map("revoke_reason")

  user   User           @relation(fields: [userId], references: [id])
  device UserDevice?    @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  tokens RefreshToken[]

  @@index([userId])
  @@map("auth_sessions")
}

/// Rotated on every use. Presenting a token that was already used revokes the whole session.
model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  /// SHA-256 of the random token. The token itself is never stored.
  tokenHash    String    @unique @map("token_hash")
  issuedAt     DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid

  session    AuthSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: Restrict)
  replaces   RefreshToken? @relation("RefreshTokenRotation")

  @@index([sessionId])
  @@map("refresh_tokens")
}

/// Activation, password-reset and email-change links. Only a hash is stored.
model UserToken {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
  @@map("user_tokens")
}

/// Partial unique index (SQL): one TRUSTED attendance device per user.
model UserDevice {
  id                   String         @id @default(uuid(7)) @db.Uuid
  userId               String         @map("user_id") @db.Uuid
  /// Random ID created on first launch and kept in the phone's secure storage.
  installationId       String         @map("installation_id")
  platform             DevicePlatform
  model                String?
  osVersion            String?        @map("os_version")
  appVersion           String?        @map("app_version")
  /// The phone's Ed25519 public key (base64url, 32 bytes). The private key never leaves the phone;
  /// the server verifies the phone's signatures with this key and holds no secret of its own.
  publicKey            String?        @map("public_key")
  /// A student's request to make this phone their attendance phone, and why (D-10).
  trustRequestedAt     DateTime?      @map("trust_requested_at") @db.Timestamptz(3)
  trustRequestReason   String?        @map("trust_request_reason")
  isAttendanceDevice   Boolean        @default(false) @map("is_attendance_device")
  status               DeviceStatus   @default(PENDING_APPROVAL)
  trustedAt            DateTime?      @map("trusted_at") @db.Timestamptz(3)
  approvedById         String?        @map("approved_by_id") @db.Uuid
  revokedAt            DateTime?      @map("revoked_at") @db.Timestamptz(3)
  revokedById          String?        @map("revoked_by_id") @db.Uuid
  revokeReason         String?        @map("revoke_reason")
  lastIntegrityVerdict Json?          @map("last_integrity_verdict")
  lastIntegrityAt      DateTime?      @map("last_integrity_at") @db.Timestamptz(3)
  pushToken            String?        @map("push_token")
  pushTokenUpdatedAt   DateTime?      @map("push_token_updated_at") @db.Timestamptz(3)
  lastSeenAt           DateTime?      @map("last_seen_at") @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user               User                @relation("DeviceOwner", fields: [userId], references: [id])
  approvedBy         User?               @relation("DeviceApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  revokedBy          User?               @relation("DeviceRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  sessions           AuthSession[]
  riskFlags          RiskFlag[]
  beaconObservations BeaconObservation[]
  attendanceAttempts AttendanceAttempt[]

  @@unique([userId, installationId])
  /// Spots one phone used by several accounts.
  @@index([installationId])
  @@map("user_devices")
}

/// Append-only: a database trigger rejects UPDATE and DELETE.
model AuditLog {
  id           String    @id @default(uuid(7)) @db.Uuid
  occurredAt   DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorType    ActorType @map("actor_type")
  actorUserId  String?   @map("actor_user_id") @db.Uuid
  actorRoleKey RoleKey?  @map("actor_role_key")
  /// e.g. "attendance.record.corrected"
  action       String
  entityType   String    @map("entity_type")
  entityId     String?   @map("entity_id")
  before       Json?
  after        Json?
  reason       String?
  requestId    String?   @map("request_id")
  ip           String?
  userAgent    String?   @map("user_agent")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_logs")
}

/// Single-use backup codes for two-factor sign-in. Only a SHA-256 hash is stored.
model MfaRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @unique @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("mfa_recovery_codes")
}

// ───────────────────────── Academic structure (Phase 2) ─────────────────────────
// Everything here is entered by authorised staff; nothing about Knutsford is seeded or invented.
// Records are deactivated, never deleted, so history keeps pointing at them.

enum SemesterStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum CalendarExceptionType {
  PUBLIC_HOLIDAY
  UNIVERSITY_CLOSURE
  EXAM_PERIOD
  OTHER
}

model Faculty {
  id        String   @id @default(uuid(7)) @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  departments Department[]

  @@map("faculties")
}

model Department {
  id        String   @id @default(uuid(7)) @db.Uuid
  facultyId String   @map("faculty_id") @db.Uuid
  code      String   @unique
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  faculty    Faculty           @relation(fields: [facultyId], references: [id])
  programmes Programme[]
  courses    Course[]
  lecturers  LecturerProfile[]

  @@index([facultyId])
  @@map("departments")
}

model Programme {
  id            String   @id @default(uuid(7)) @db.Uuid
  departmentId  String   @map("department_id") @db.Uuid
  code          String   @unique
  name          String
  /// e.g. the award name, as the university states it
  qualification String?
  durationYears Int?     @map("duration_years")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  department      Department       @relation(fields: [departmentId], references: [id])
  sections        CourseSection[]
  studentProfiles StudentProfile[]

  @@index([departmentId])
  @@map("programmes")
}

model AcademicLevel {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// As the university names its levels (entered by staff).
  code      String   @unique
  name      String
  sortOrder Int      @unique @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sections        CourseSection[]
  studentProfiles StudentProfile[]

  @@map("academic_levels")
}

/// Partial unique index (SQL): only one current year. Exclusion constraint (SQL): years never overlap.
model AcademicYear {
  id        String   @id @default(uuid(7)) @db.Uuid
  label     String   @unique
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  semesters       Semester[]
  studentProfiles StudentProfile[]

  @@map("academic_years")
}

/// Partial unique index (SQL): at most one ACTIVE semester. Exclusion constraint (SQL): semesters never overlap.
model Semester {
  id             String         @id @default(uuid(7)) @db.Uuid
  academicYearId String         @map("academic_year_id") @db.Uuid
  number         Int
  name           String
  startDate      DateTime       @map("start_date") @db.Date
  endDate        DateTime       @map("end_date") @db.Date
  status         SemesterStatus @default(PLANNED)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id])
  calendarExceptions CalendarException[]
  offerings          CourseOffering[]
  studentProfiles    StudentProfile[]
  timetables         Timetable[]

  @@unique([academicYearId, number])
  @@map("semesters")
}

/// Holidays and closures: no class sessions are generated on these dates (Phase 3).
model CalendarException {
  id                String                @id @default(uuid(7)) @db.Uuid
  semesterId        String?               @map("semester_id") @db.Uuid
  type              CalendarExceptionType
  name              String
  startDate         DateTime              @map("start_date") @db.Date
  endDate           DateTime              @map("end_date") @db.Date
  suppressesClasses Boolean               @default(true) @map("suppresses_classes")
  createdById       String                @map("created_by_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  semester  Semester? @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  createdBy User      @relation("CalendarExceptionCreatedBy", fields: [createdById], references: [id])

  @@index([startDate, endDate])
  @@map("calendar_exceptions")
}

// ───────────────────────── Places (Phase 2) ─────────────────────────
// Geofences are a centre point and radius in metres, entered by staff from a site survey.
// A building's geofence, when set, overrides its campus's for rooms in that building.

model Campus {
  id              String   @id @default(uuid(7)) @db.Uuid
  code            String   @unique
  name            String
  geofenceLat     Decimal? @map("geofence_lat") @db.Decimal(9, 6)
  geofenceLng     Decimal? @map("geofence_lng") @db.Decimal(9, 6)
  geofenceRadiusM Int?     @map("geofence_radius_m")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  buildings Building[]

  @@map("campuses")
}

model Building {
  id              String   @id @default(uuid(7)) @db.Uuid
  campusId        String   @map("campus_id") @db.Uuid
  code            String
  name            String
  geofenceLat     Decimal? @map("geofence_lat") @db.Decimal(9, 6)
  geofenceLng     Decimal? @map("geofence_lng") @db.Decimal(9, 6)
  geofenceRadiusM Int?     @map("geofence_radius_m")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  campus     Campus      @relation(fields: [campusId], references: [id])
  classrooms Classroom[]

  @@unique([campusId, code])
  @@map("buildings")
}

model Classroom {
  id         String   @id @default(uuid(7)) @db.Uuid
  buildingId String   @map("building_id") @db.Uuid
  code       String
  name       String
  /// As the building labels it, e.g. "Ground" or "2".
  floor      String?
  capacity   Int?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  building           Building            @relation(fields: [buildingId], references: [id])
  timetableEntries   TimetableEntry[]
  classSessions      ClassSession[]
  rescheduleRequests RescheduleRequest[]
  beacons            Beacon[]
  calibrationSurveys CalibrationSurvey[]
  beaconObservations BeaconObservation[]

  @@unique([buildingId, code])
  @@map("classrooms")
}

// ───────────────────────── Courses and lecturers (Phase 2) ─────────────────────────

enum OfferingStatus {
  DRAFT
  OPEN
  CLOSED
}

enum StaffStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model Course {
  id           String   @id @default(uuid(7)) @db.Uuid
  code         String   @unique
  title        String
  creditHours  Int?     @map("credit_hours")
  departmentId String   @map("department_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  department Department       @relation(fields: [departmentId], references: [id])
  offerings  CourseOffering[]

  @@index([departmentId])
  @@map("courses")
}

/// A course running in one semester.
model CourseOffering {
  id         String         @id @default(uuid(7)) @db.Uuid
  courseId   String         @map("course_id") @db.Uuid
  semesterId String         @map("semester_id") @db.Uuid
  status     OfferingStatus @default(DRAFT)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  course            Course             @relation(fields: [courseId], references: [id])
  semester          Semester           @relation(fields: [semesterId], references: [id])
  sections          CourseSection[]
  courseEnrollments CourseEnrollment[]

  @@unique([courseId, semesterId])
  @@index([semesterId])
  @@map("course_offerings")
}

/// A class group inside an offering. Programme and level are optional hints for timetable clash checks.
model CourseSection {
  id          String   @id @default(uuid(7)) @db.Uuid
  offeringId  String   @map("offering_id") @db.Uuid
  code        String
  name        String?
  capacity    Int?
  programmeId String?  @map("programme_id") @db.Uuid
  levelId     String?  @map("level_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  offering               CourseOffering          @relation(fields: [offeringId], references: [id])
  programme              Programme?              @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  level                  AcademicLevel?          @relation(fields: [levelId], references: [id], onDelete: Restrict)
  assignments            LecturerAssignment[]
  courseEnrollments      CourseEnrollment[]
  courseRepAssignments   CourseRepAssignment[]
  timetableEntrySections TimetableEntrySection[]
  classSessionSections   ClassSessionSection[]

  @@unique([offeringId, code])
  @@map("course_sections")
}

model LecturerProfile {
  id           String      @id @default(uuid(7)) @db.Uuid
  userId       String      @unique @map("user_id") @db.Uuid
  /// Format to be confirmed by the university (decision D-14); stored in capitals.
  staffNumber  String      @unique @map("staff_number")
  departmentId String      @map("department_id") @db.Uuid
  title        String?
  status       StaffStatus @default(ACTIVE)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user             User                 @relation(fields: [userId], references: [id])
  department       Department           @relation(fields: [departmentId], references: [id])
  assignments      LecturerAssignment[]
  timetableEntries TimetableEntry[]
  classSessions    ClassSession[]

  @@index([departmentId])
  @@map("lecturer_profiles")
}

/// Partial unique indexes (SQL): one active assignment per lecturer and section; one active primary per section.
model LecturerAssignment {
  id           String    @id @default(uuid(7)) @db.Uuid
  lecturerId   String    @map("lecturer_id") @db.Uuid
  sectionId    String    @map("section_id") @db.Uuid
  isPrimary    Boolean   @default(true) @map("is_primary")
  assignedById String    @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(3)
  endedById    String?   @map("ended_by_id") @db.Uuid

  lecturer   LecturerProfile @relation(fields: [lecturerId], references: [id])
  section    CourseSection   @relation(fields: [sectionId], references: [id])
  assignedBy User            @relation("AssignmentAssignedBy", fields: [assignedById], references: [id])
  endedBy    User?           @relation("AssignmentEndedBy", fields: [endedById], references: [id], onDelete: Restrict)

  @@index([sectionId])
  @@index([lecturerId])
  @@map("lecturer_assignments")
}

// ───────────────────────── Students (Phase 2) ─────────────────────────

enum StudentStatus {
  ACTIVE
  DEFERRED
  SUSPENDED
  WITHDRAWN
  GRADUATED
}

/// Faculty and department come from the programme, so they can never contradict it.
model StudentProfile {
  id                    String        @id @default(uuid(7)) @db.Uuid
  userId                String        @unique @map("user_id") @db.Uuid
  /// The university's Student ID: 8 digits (format confirmed by the product owner, 2026-11-08).
  studentNumber         String        @unique @map("student_number")
  programmeId           String        @map("programme_id") @db.Uuid
  levelId               String        @map("level_id") @db.Uuid
  currentAcademicYearId String        @map("current_academic_year_id") @db.Uuid
  currentSemesterId     String        @map("current_semester_id") @db.Uuid
  status                StudentStatus @default(ACTIVE)
  /// Set by the Registrar for a student without a compatible phone (lecturer-assisted check-in).
  noDeviceExemption     Boolean       @default(false) @map("no_device_exemption")
  registeredById        String        @map("registered_by_id") @db.Uuid
  verifiedAt            DateTime?     @map("verified_at") @db.Timestamptz(3)
  verifiedById          String?       @map("verified_by_id") @db.Uuid
  /// Optional profile photo (JPEG or PNG).
  photoFileId           String?       @unique @map("photo_file_id") @db.Uuid
  version               Int           @default(0)
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                 User                  @relation("StudentUser", fields: [userId], references: [id])
  programme            Programme             @relation(fields: [programmeId], references: [id])
  level                AcademicLevel         @relation(fields: [levelId], references: [id])
  currentAcademicYear  AcademicYear          @relation(fields: [currentAcademicYearId], references: [id])
  currentSemester      Semester              @relation(fields: [currentSemesterId], references: [id])
  registeredBy         User                  @relation("StudentRegisteredBy", fields: [registeredById], references: [id])
  verifiedBy           User?                 @relation("StudentVerifiedBy", fields: [verifiedById], references: [id], onDelete: Restrict)
  photo                FileObject?           @relation(fields: [photoFileId], references: [id], onDelete: Restrict)
  courseEnrollments    CourseEnrollment[]
  courseRepAssignments CourseRepAssignment[]
  riskFlags            RiskFlag[]
  attendanceRecords    AttendanceRecord[]
  attendanceAttempts   AttendanceAttempt[]

  @@index([programmeId, levelId])
  @@index([status])
  @@map("student_profiles")
}

// ───────────────────────── Files and imports (Phase 2) ─────────────────────────

enum FilePurpose {
  PROFILE_PHOTO
  IMPORT_FILE
}

enum FileStatus {
  STORED
  /// Replaced or no longer needed; the stored bytes have been deleted.
  REMOVED
}

/// A file in private storage. The type is checked from the file's bytes, never trusted from its name.
model FileObject {
  id           String      @id @default(uuid(7)) @db.Uuid
  bucket       String
  /// Random, so it reveals nothing about the owner.
  key          String      @unique
  purpose      FilePurpose
  mimeType     String      @map("mime_type")
  sizeBytes    Int         @map("size_bytes")
  sha256       String
  originalName String?     @map("original_name")
  status       FileStatus  @default(STORED)
  uploadedById String      @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt    DateTime?   @map("removed_at") @db.Timestamptz(3)

  uploadedBy   User            @relation(fields: [uploadedById], references: [id])
  studentPhoto StudentProfile?
  importBatch  ImportBatch?

  @@map("file_objects")
}

enum ImportType {
  STUDENTS
  ENROLLMENTS
}

enum ImportFormat {
  CSV
  XLSX
}

/// VALIDATED: checked and waiting for a person to confirm. Nothing is saved before confirmation.
enum ImportStatus {
  VALIDATED
  IMPORTING
  COMPLETED
  CANCELLED
}

enum ImportRowStatus {
  VALID
  INVALID
  DUPLICATE_IN_FILE
  DUPLICATE_EXISTING
  IMPORTED
}

enum EmailStatus {
  PENDING
  SENT
  FAILED
}

model ImportBatch {
  id            String       @id @default(uuid(7)) @db.Uuid
  type          ImportType
  format        ImportFormat
  fileId        String       @unique @map("file_id") @db.Uuid
  status        ImportStatus @default(VALIDATED)
  totalRows     Int          @default(0) @map("total_rows")
  validRows     Int          @default(0) @map("valid_rows")
  invalidRows   Int          @default(0) @map("invalid_rows")
  duplicateRows Int          @default(0) @map("duplicate_rows")
  importedRows  Int          @default(0) @map("imported_rows")
  uploadedById  String       @map("uploaded_by_id") @db.Uuid
  /// Who confirmed or cancelled it.
  decidedById   String?      @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?    @map("decided_at") @db.Timestamptz(3)
  completedAt   DateTime?    @map("completed_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  file              FileObject         @relation(fields: [fileId], references: [id])
  uploadedBy        User               @relation("ImportUploadedBy", fields: [uploadedById], references: [id])
  decidedBy         User?              @relation("ImportDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  rows              ImportRow[]
  courseEnrollments CourseEnrollment[]

  @@index([type, createdAt])
  @@map("import_batches")
}

model ImportRow {
  id              String          @id @default(uuid(7)) @db.Uuid
  batchId         String          @map("batch_id") @db.Uuid
  /// The spreadsheet row number, counting the header as row 1, so staff can find it in their file.
  rowNumber       Int             @map("row_number")
  raw             Json
  normalized      Json?
  /// [{ column, code, message }]
  errors          Json?
  status          ImportRowStatus
  createdEntityId String?         @map("created_entity_id") @db.Uuid
  /// Activation email for an account the import created.
  emailStatus     EmailStatus?    @map("email_status")

  batch ImportBatch @relation(fields: [batchId], references: [id])

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@map("import_rows")
}

// ───────────────────────── Enrolments and course reps (Phase 2) ─────────────────────────

enum EnrollmentStatus {
  ENROLLED
  DROPPED
  WITHDRAWN
}

/// Partial unique index (SQL): one ENROLLED row per student and offering. Ended rows stay as history.
model CourseEnrollment {
  id            String           @id @default(uuid(7)) @db.Uuid
  studentId     String           @map("student_id") @db.Uuid
  /// Stored with the section so one student cannot hold two sections of one offering.
  offeringId    String           @map("offering_id") @db.Uuid
  sectionId     String           @map("section_id") @db.Uuid
  status        EnrollmentStatus @default(ENROLLED)
  /// Server time. Classes before this moment do not count for the student.
  enrolledAt    DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz(3)
  endedAt       DateTime?        @map("ended_at") @db.Timestamptz(3)
  endedById     String?          @map("ended_by_id") @db.Uuid
  endReason     String?          @map("end_reason")
  importBatchId String?          @map("import_batch_id") @db.Uuid
  createdById   String           @map("created_by_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  student     StudentProfile @relation(fields: [studentId], references: [id])
  offering    CourseOffering @relation(fields: [offeringId], references: [id])
  section     CourseSection  @relation(fields: [sectionId], references: [id])
  importBatch ImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  createdBy   User           @relation("EnrollmentCreatedBy", fields: [createdById], references: [id])
  endedBy     User?          @relation("EnrollmentEndedBy", fields: [endedById], references: [id], onDelete: Restrict)

  @@index([sectionId, status])
  @@index([studentId, status])
  @@map("course_enrollments")
}

/// NOMINATED by a lecturer, then ACTIVE once an administrator approves (or appoints directly), until ENDED.
enum CourseRepStatus {
  NOMINATED
  ACTIVE
  ENDED
  REJECTED
}

/// Partial unique index (SQL): one open (NOMINATED or ACTIVE) assignment per student and section.
model CourseRepAssignment {
  id             String          @id @default(uuid(7)) @db.Uuid
  studentId      String          @map("student_id") @db.Uuid
  /// The semester comes from section → offering → semester.
  sectionId      String          @map("section_id") @db.Uuid
  status         CourseRepStatus
  nominatedById  String?         @map("nominated_by_id") @db.Uuid
  nominationNote String?         @map("nomination_note")
  assignedById   String?         @map("assigned_by_id") @db.Uuid
  startsAt       DateTime?       @map("starts_at") @db.Timestamptz(3)
  endedAt        DateTime?       @map("ended_at") @db.Timestamptz(3)
  endedById      String?         @map("ended_by_id") @db.Uuid
  endReason      String?         @map("end_reason")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  student     StudentProfile @relation(fields: [studentId], references: [id])
  section     CourseSection  @relation(fields: [sectionId], references: [id])
  nominatedBy User?          @relation("RepNominatedBy", fields: [nominatedById], references: [id], onDelete: Restrict)
  assignedBy  User?          @relation("RepAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  endedBy     User?          @relation("RepEndedBy", fields: [endedById], references: [id], onDelete: Restrict)

  @@index([sectionId, status])
  @@index([studentId, status])
  @@map("course_rep_assignments")
}

// ───────────────────────── Background jobs, outbox and settings (Phase 3) ─────────────────────────

enum Severity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  /// Failed this attempt; will be retried.
  FAILED
  /// Failed its final attempt; a system event was raised.
  DEAD
}

/// Versioned institution settings, e.g. "monitoring.unconfirmedAfterMinutes". A missing row means the
/// catalogue default (packages/shared/src/settings.ts) applies.
model InstitutionSetting {
  key         String   @id
  value       Json
  version     Int      @default(0)
  updatedById String   @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User @relation("SettingUpdatedBy", fields: [updatedById], references: [id])

  @@map("institution_settings")
}

/// Written in the same transaction as the change it follows; the relay turns each row into a job.
model OutboxEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  type        String
  payload     Json
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([publishedAt, createdAt])
  @@map("outbox_events")
}

/// One row per job, so every background task is visible and its failures are recorded.
model BackgroundJobRecord {
  id             String    @id @default(uuid(7)) @db.Uuid
  queue          String
  name           String
  jobId          String    @map("job_id")
  idempotencyKey String?   @unique @map("idempotency_key")
  status         JobStatus @default(QUEUED)
  attempts       Int       @default(0)
  lastError      String?   @map("last_error")
  scheduledFor   DateTime? @map("scheduled_for") @db.Timestamptz(3)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([queue, status])
  @@map("background_job_records")
}

/// Things the Super Admin's system-health view must see, such as a job that failed for good.
model SystemEvent {
  id               String    @id @default(uuid(7)) @db.Uuid
  type             String
  severity         Severity
  source           String
  message          String
  data             Json?
  acknowledgedById String?   @map("acknowledged_by_id") @db.Uuid
  acknowledgedAt   DateTime? @map("acknowledged_at") @db.Timestamptz(3)
  occurredAt       DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)

  acknowledgedBy User? @relation("SystemEventAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: Restrict)

  @@index([severity, occurredAt])
  @@map("system_events")
}

// ───────────────────────── Timetables (Phase 3) ─────────────────────────

enum TimetableStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

/// How an entry repeats (decided 2026-11-09). WEEKLY is the default.
enum Recurrence {
  WEEKLY
  EVERY_OTHER_WEEK
  SELECTED_WEEKS
  ONCE
}

/// Partial unique indexes (SQL): at most one DRAFT and one PUBLISHED timetable per semester.
model Timetable {
  id                  String          @id @default(uuid(7)) @db.Uuid
  semesterId          String          @map("semester_id") @db.Uuid
  name                String
  version             Int
  status              TimetableStatus @default(DRAFT)
  publishedAt         DateTime?       @map("published_at") @db.Timestamptz(3)
  publishedById       String?         @map("published_by_id") @db.Uuid
  /// Set when the class sessions for this published version have been generated.
  sessionsGeneratedAt DateTime?       @map("sessions_generated_at") @db.Timestamptz(3)
  createdById         String          @map("created_by_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  semester    Semester          @relation(fields: [semesterId], references: [id])
  publishedBy User?             @relation("TimetablePublishedBy", fields: [publishedById], references: [id], onDelete: Restrict)
  createdBy   User              @relation("TimetableCreatedBy", fields: [createdById], references: [id])
  entries     TimetableEntry[]
  changes     TimetableChange[]

  @@unique([semesterId, version])
  @@map("timetables")
}

/// A repeating (or one-time) meeting: when, where, who teaches, which sections.
model TimetableEntry {
  id            String     @id @default(uuid(7)) @db.Uuid
  timetableId   String     @map("timetable_id") @db.Uuid
  lecturerId    String     @map("lecturer_id") @db.Uuid
  classroomId   String     @map("classroom_id") @db.Uuid
  /// 1 = Monday … 7 = Sunday.
  dayOfWeek     Int        @map("day_of_week")
  /// Minutes after midnight, Africa/Accra time.
  startMinute   Int        @map("start_minute")
  endMinute     Int        @map("end_minute")
  recurrence    Recurrence @default(WEEKLY)
  /// For SELECTED_WEEKS: teaching-week numbers, where week 1 is the semester's first week.
  selectedWeeks Int[]      @map("selected_weeks")
  effectiveFrom DateTime   @map("effective_from") @db.Date
  effectiveTo   DateTime   @map("effective_to") @db.Date
  /// The entry this one was copied from (the previous version), so its future sessions carry over.
  sourceEntryId String?    @map("source_entry_id") @db.Uuid
  isCancelled   Boolean    @default(false) @map("is_cancelled")
  version       Int        @default(0)
  createdById   String     @map("created_by_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  timetable     Timetable                 @relation(fields: [timetableId], references: [id])
  lecturer      LecturerProfile           @relation(fields: [lecturerId], references: [id])
  classroom     Classroom                 @relation(fields: [classroomId], references: [id])
  createdBy     User                      @relation("TimetableEntryCreatedBy", fields: [createdById], references: [id])
  sections      TimetableEntrySection[]
  exceptions    TimetableEntryException[]
  classSessions ClassSession[]

  @@index([timetableId])
  @@map("timetable_entries")
}

/// Several sections can share one meeting (a combined class).
model TimetableEntrySection {
  entryId   String @map("entry_id") @db.Uuid
  sectionId String @map("section_id") @db.Uuid

  entry   TimetableEntry @relation(fields: [entryId], references: [id])
  section CourseSection  @relation(fields: [sectionId], references: [id])

  @@id([entryId, sectionId])
  @@index([sectionId])
  @@map("timetable_entry_sections")
}

/// One date an entry does not meet, besides university-wide holidays.
model TimetableEntryException {
  id          String   @id @default(uuid(7)) @db.Uuid
  entryId     String   @map("entry_id") @db.Uuid
  date        DateTime @db.Date
  reason      String
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  entry     TimetableEntry @relation(fields: [entryId], references: [id])
  createdBy User           @relation("TimetableExceptionCreatedBy", fields: [createdById], references: [id])

  @@unique([entryId, date])
  @@map("timetable_entry_exceptions")
}

/// History of every timetable change.
model TimetableChange {
  id          String   @id @default(uuid(7)) @db.Uuid
  timetableId String   @map("timetable_id") @db.Uuid
  entryId     String?  @map("entry_id") @db.Uuid
  /// CREATED | ENTRY_ADDED | ENTRY_UPDATED | ENTRY_CANCELLED | EXCEPTION_ADDED | EXCEPTION_REMOVED | PUBLISHED | SUPERSEDED
  changeType  String   @map("change_type")
  before      Json?
  after       Json?
  reason      String?
  changedById String   @map("changed_by_id") @db.Uuid
  changedAt   DateTime @default(now()) @map("changed_at") @db.Timestamptz(3)

  timetable Timetable @relation(fields: [timetableId], references: [id])
  changedBy User      @relation("TimetableChangedBy", fields: [changedById], references: [id])

  @@index([timetableId, changedAt])
  @@map("timetable_changes")
}

// ───────────────────────── Class sessions (Phase 3) ─────────────────────────

enum SessionKind {
  REGULAR
  MAKEUP
  REPLACEMENT
}

/// The 11 class statuses (CLASS_LIFECYCLE.md §3).
enum ClassStatus {
  SCHEDULED
  CONFIRMED
  POSTPONED
  UNCONFIRMED
  UNDER_REVIEW
  ACTIVE
  INTERRUPTED
  COMPLETED
  CANCELLED
  RESCHEDULED
  SUSPENDED
}

enum ClassEventType {
  GENERATED
  UPDATED
  VENUE_CHANGED
  REMINDER_SENT
  CONFIRMED
  STARTED
  DELAY_REPORTED
  MARKED_UNCONFIRMED
  LECTURER_PROMPTED
  ISSUE_REPORTED
  ESCALATED
  REVIEW_DECIDED
  CANCELLED
  RESCHEDULED
  SUSPENDED
  RESUMED
  INTERRUPTED
  ENDED
  AUTO_ENDED
  ATTENDANCE_OPENED
  ATTENDANCE_CLOSED
  ATTENDANCE_REOPENED
  ATTENDANCE_VOIDED
  REINSTATED
  /// Phones in the room could not hear its beacon during the class: check-ins wait for the lecturer.
  BEACON_DEGRADED
}

enum CancelReason {
  LECTURER_UNAVAILABLE
  ILLNESS
  OFFICIAL_DUTY
  VENUE_UNAVAILABLE
  INSTITUTION_EVENT
  PUBLIC_HOLIDAY
  EMERGENCY
  LECTURER_ABSENT_NO_NOTICE
  OTHER
}

/// One concrete class meeting. Exclusion constraints (SQL): no room and no lecturer has two live
/// sessions at overlapping times. A re-run of generation never duplicates (entry, start).
model ClassSession {
  id                         String        @id @default(uuid(7)) @db.Uuid
  /// Null for make-up and replacement sessions.
  timetableEntryId           String?       @map("timetable_entry_id") @db.Uuid
  kind                       SessionKind   @default(REGULAR)
  lecturerId                 String        @map("lecturer_id") @db.Uuid
  classroomId                String        @map("classroom_id") @db.Uuid
  scheduledStart             DateTime      @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd               DateTime      @map("scheduled_end") @db.Timestamptz(3)
  /// Set when a delay is reported.
  expectedStart              DateTime?     @map("expected_start") @db.Timestamptz(3)
  actualStart                DateTime?     @map("actual_start") @db.Timestamptz(3)
  actualEnd                  DateTime?     @map("actual_end") @db.Timestamptz(3)
  status                     ClassStatus   @default(SCHEDULED)
  statusChangedAt            DateTime      @default(now()) @map("status_changed_at") @db.Timestamptz(3)
  cancelReason               CancelReason? @map("cancel_reason")
  cancelNote                 String?       @map("cancel_note")
  cancelledById              String?       @map("cancelled_by_id") @db.Uuid
  /// True when a timetable or calendar change cancelled the class (not a person's decision), so undoing
  /// that change may bring the class back. A class a person cancelled is never brought back.
  cancelledByTimetableChange Boolean       @default(false) @map("cancelled_by_timetable_change")
  /// On a replacement session: the session it replaces.
  rescheduledFromId          String?       @unique @map("rescheduled_from_id") @db.Uuid
  version                    Int           @default(0)
  createdAt                  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  timetableEntry     TimetableEntry?       @relation(fields: [timetableEntryId], references: [id], onDelete: Restrict)
  lecturer           LecturerProfile       @relation(fields: [lecturerId], references: [id])
  classroom          Classroom             @relation(fields: [classroomId], references: [id])
  cancelledBy        User?                 @relation("ClassSessionCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  sections           ClassSessionSection[]
  events             ClassEvent[]
  rescheduledFrom    ClassSession?         @relation("SessionReplacement", fields: [rescheduledFromId], references: [id], onDelete: Restrict)
  replacedBy         ClassSession?         @relation("SessionReplacement")
  rescheduleRequests RescheduleRequest[]   @relation("RescheduleOriginal")
  replacementFor     RescheduleRequest?    @relation("RescheduleReplacement")
  issueReports       ClassIssueReport[]
  reviews            ClassStatusReview[]
  attendanceSession  AttendanceSession?
  attendanceRecords  AttendanceRecord[]

  @@unique([timetableEntryId, scheduledStart])
  @@index([status, scheduledStart])
  @@index([lecturerId, scheduledStart])
  @@index([classroomId, scheduledStart])
  @@map("class_sessions")
}

model ClassSessionSection {
  classSessionId String @map("class_session_id") @db.Uuid
  sectionId      String @map("section_id") @db.Uuid

  classSession ClassSession  @relation(fields: [classSessionId], references: [id])
  section      CourseSection @relation(fields: [sectionId], references: [id])

  @@id([classSessionId, sectionId])
  @@index([sectionId])
  @@map("class_session_sections")
}

/// Append-only history of a session (a database trigger rejects UPDATE and DELETE).
model ClassEvent {
  id             String         @id @default(uuid(7)) @db.Uuid
  classSessionId String         @map("class_session_id") @db.Uuid
  type           ClassEventType
  fromStatus     ClassStatus?   @map("from_status")
  toStatus       ClassStatus?   @map("to_status")
  actorType      ActorType      @map("actor_type")
  actorUserId    String?        @map("actor_user_id") @db.Uuid
  payload        Json?
  occurredAt     DateTime       @default(now()) @map("occurred_at") @db.Timestamptz(3)

  classSession ClassSession @relation(fields: [classSessionId], references: [id])
  actor        User?        @relation("ClassEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([classSessionId, occurredAt])
  @@map("class_events")
}

// ───────────────────────── Reschedules (Phase 3) ─────────────────────────

enum RescheduleStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

/// A lecturer's request to move a class (D-11), or an administrator's direct reschedule (recorded as
/// approved at once). Partial unique index (SQL): at most one pending request per session.
model RescheduleRequest {
  id                   String           @id @default(uuid(7)) @db.Uuid
  classSessionId       String           @map("class_session_id") @db.Uuid
  requestedById        String           @map("requested_by_id") @db.Uuid
  proposedStart        DateTime         @map("proposed_start") @db.Timestamptz(3)
  proposedEnd          DateTime         @map("proposed_end") @db.Timestamptz(3)
  proposedClassroomId  String           @map("proposed_classroom_id") @db.Uuid
  reason               String
  status               RescheduleStatus @default(PENDING)
  /// True when an administrator rescheduled directly, without a lecturer's request.
  isDirect             Boolean          @default(false) @map("is_direct")
  decidedById          String?          @map("decided_by_id") @db.Uuid
  decidedAt            DateTime?        @map("decided_at") @db.Timestamptz(3)
  decisionNote         String?          @map("decision_note")
  replacementSessionId String?          @unique @map("replacement_session_id") @db.Uuid
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  classSession       ClassSession  @relation("RescheduleOriginal", fields: [classSessionId], references: [id])
  replacementSession ClassSession? @relation("RescheduleReplacement", fields: [replacementSessionId], references: [id], onDelete: Restrict)
  proposedClassroom  Classroom     @relation(fields: [proposedClassroomId], references: [id])
  requestedBy        User          @relation("RescheduleRequestedBy", fields: [requestedById], references: [id])
  decidedBy          User?         @relation("RescheduleDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([classSessionId])
  @@map("reschedule_requests")
}

// ───────────────────────── Class monitoring (Phase 3 step 5) ─────────────────────────

enum IssueType {
  LECTURER_NOT_ARRIVED
  VERBAL_CANCELLATION
  CLASS_DELAYED
  WRONG_CLASSROOM
  VENUE_PROBLEM
  TIMETABLE_ERROR
  TECHNICAL_PROBLEM
  OTHER
}

enum ReporterRole {
  STUDENT
  COURSE_REP
  LECTURER
}

enum IssueReportStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum ReviewTrigger {
  SYSTEM_ESCALATION
  ADMIN_OPENED
}

enum ReviewStatus {
  OPEN
  DECIDED
}

enum ReviewDecision {
  CLASS_HELD
  CANCELLED
  POSTPONED
  RESCHEDULED
  NO_ACTION
}

/// A problem with a class reported by an enrolled student, a course rep or the class's lecturer.
/// One report per person, type and class. Reports are evidence for the detection engine; they never
/// change a class's status by themselves.
model ClassIssueReport {
  id             String            @id @default(uuid(7)) @db.Uuid
  classSessionId String            @map("class_session_id") @db.Uuid
  reporterUserId String            @map("reporter_user_id") @db.Uuid
  reporterRole   ReporterRole      @map("reporter_role")
  type           IssueType
  note           String?
  status         IssueReportStatus @default(OPEN)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Restrict)
  reporter     User         @relation("IssueReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)

  @@unique([classSessionId, reporterUserId, type])
  @@index([classSessionId, createdAt])
  @@index([reporterUserId, createdAt])
  @@map("class_issue_reports")
}

/// A class referred to an administrator: by the detection engine, or by an administrator.
/// At most one open review per class (partial unique index in SQL).
model ClassStatusReview {
  id             String          @id @default(uuid(7)) @db.Uuid
  classSessionId String          @map("class_session_id") @db.Uuid
  trigger        ReviewTrigger
  /// A course rep reported, or a student reported a verbal cancellation: look at this one first.
  isPriority     Boolean         @default(false) @map("is_priority")
  /// Why it was opened: the detection engine's reasons, or the administrator's reason.
  reasons        Json
  openedAt       DateTime        @map("opened_at") @db.Timestamptz(3)
  status         ReviewStatus    @default(OPEN)
  decision       ReviewDecision?
  decisionNote   String?         @map("decision_note")
  decidedById    String?         @map("decided_by_id") @db.Uuid
  decidedAt      DateTime?       @map("decided_at") @db.Timestamptz(3)

  classSession ClassSession @relation(fields: [classSessionId], references: [id], onDelete: Restrict)
  decidedBy    User?        @relation("ReviewDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([status, isPriority, openedAt])
  @@index([classSessionId])
  @@map("class_status_reviews")
}

// ───────────────────────── Notifications (Phase 3 step 6) ─────────────────────────
// Decision 2026-11-09: in-app and email first; push is designed in but switched off until a
// university-owned Firebase project exists. SMS waits for D-17.

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum NotificationPriority {
  NORMAL
  HIGH
  CRITICAL
}

enum DeliveryStatus {
  QUEUED
  SENT
  FAILED
  SUPPRESSED
}

/// One message to one person. It is always shown in the app; other channels get a delivery row each.
model Notification {
  id                String               @id @default(uuid(7)) @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  category          String
  title             String
  body              String
  /// Where it leads in the apps, and the action buttons to show.
  data              Json?
  priority          NotificationPriority @default(NORMAL)
  relatedEntityType String?              @map("related_entity_type")
  relatedEntityId   String?              @map("related_entity_id") @db.Uuid
  /// The same message is never created twice for one person.
  dedupeKey         String?              @map("dedupe_key")
  /// If still unread at this time, it is also sent by email (then cleared).
  emailIfUnreadAt   DateTime?            @map("email_if_unread_at") @db.Timestamptz(3)
  readAt            DateTime?            @map("read_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([emailIfUnreadAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String              @id @default(uuid(7)) @db.Uuid
  notificationId String              @map("notification_id") @db.Uuid
  channel        NotificationChannel
  status         DeliveryStatus      @default(QUEUED)
  attempts       Int                 @default(0)
  lastError      String?             @map("last_error")
  sentAt         DateTime?           @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Restrict)

  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

/// A person's choice to turn a channel off for a category. Mandatory categories ignore it.
model NotificationPreference {
  userId    String              @map("user_id") @db.Uuid
  category  String
  channel   NotificationChannel
  enabled   Boolean
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([userId, category, channel])
  @@map("notification_preferences")
}

// ───────────────────────── Risk flags (Phase 4 step 1) ─────────────────────────

enum RiskType {
  SHARED_DEVICE
  DEVICE_SWITCH
  ACCOUNT_SWITCH
  BEACON_LOCATION_CONFLICT
  MOCK_LOCATION
  INTEGRITY_FAILED
  REPEATED_REJECTIONS
  UNEXPECTED_BEACON
}

enum FlagStatus {
  OPEN
  DISMISSED
  CONFIRMED
}

/// Something worth a person's attention. A flag never changes attendance or access by itself:
/// a reviewer decides, with a note (PRESENCE_VERIFICATION.md §8).
model RiskFlag {
  id           String     @id @default(uuid(7)) @db.Uuid
  type         RiskType
  severity     Severity
  status       FlagStatus @default(OPEN)
  studentId    String?    @map("student_id") @db.Uuid
  deviceId     String?    @map("device_id") @db.Uuid
  /// What was seen, for the reviewer (other accounts on the phone, times, counts).
  evidence     Json
  /// The same situation is flagged once while open (for example one phone, two named students).
  dedupeKey    String?    @map("dedupe_key")
  reviewedById String?    @map("reviewed_by_id") @db.Uuid
  reviewedAt   DateTime?  @map("reviewed_at") @db.Timestamptz(3)
  reviewNote   String?    @map("review_note")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  student    StudentProfile? @relation(fields: [studentId], references: [id], onDelete: Restrict)
  device     UserDevice?     @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  reviewedBy User?           @relation("RiskFlagReviewedBy", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([studentId, createdAt])
  @@map("risk_flags")
}

// ───────────────────────── Verification policy (Phase 4 step 2) ─────────────────────────

/// The rules the verification engine follows (PRESENCE_VERIFICATION.md §9). Versions are never edited:
/// each change is a new version, so a decision made in March can be explained in May. Until the first
/// version is saved, the defaults in packages/shared apply (version 0).
model VerificationPolicy {
  id          String   @id @default(uuid(7)) @db.Uuid
  version     Int      @unique
  rules       Json
  reason      String
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@map("verification_policies")
}

// ───────────────────────── Beacons and calibration (Phase 4 step 3) ─────────────────────────
// PRESENCE_VERIFICATION.md §3. The beacon type is chosen by the classroom trial (D-08); the register
// accepts the candidate protocols, and rotating-ID resolution is completed for the one chosen.

enum BeaconProtocol {
  /// Rotating identifier (recommended): copies made yesterday are useless today.
  EDDYSTONE_EID
  /// A vendor's own secure rotating identifier.
  VENDOR_ROTATING
  /// Fixed identifiers: easy to copy; for trials only.
  EDDYSTONE_UID
  IBEACON
}

enum BeaconStatus {
  ACTIVE
  /// Phones on campus stopped hearing it during classes (beacon health, step 5).
  SUSPECTED_FAULTY
  INACTIVE
}

/// Where a calibration reading was taken. INSIDE_* count as inside the room; the rest as outside.
enum SurveyPosition {
  INSIDE_FRONT
  INSIDE_MIDDLE
  INSIDE_BACK_ROW
  INSIDE_CORNER
  DOORWAY
  CORRIDOR
  NEIGHBOUR_ROOM
  OUTSIDE_BUILDING
}

model Beacon {
  id                String         @id @default(uuid(7)) @db.Uuid
  classroomId       String         @map("classroom_id") @db.Uuid
  /// What the person installing it calls it, e.g. "Front wall above the board".
  label             String
  protocol          BeaconProtocol
  /// The broadcast identifier (fixed protocols) or the vendor's serial (rotating protocols), lower-case.
  identifier        String
  /// The rotating key, encrypted with the application key. Never returned by the API.
  rotationKeyEnc    String?        @map("rotation_key_enc")
  /// Eddystone-EID rotation exponent: the identifier changes every 2^k seconds.
  rotationExponent  Int?           @map("rotation_exponent")
  txPowerDbm        Int?           @map("tx_power_dbm")
  /// Calibrated by a survey: a reading at or above this (dBm) means inside the room.
  thresholdRssi     Int?           @map("threshold_rssi")
  status            BeaconStatus   @default(ACTIVE)
  batteryPercent    Int?           @map("battery_percent")
  batteryReportedAt DateTime?      @map("battery_reported_at") @db.Timestamptz(3)
  installedOn       DateTime?      @map("installed_on") @db.Date
  calibratedAt      DateTime?      @map("calibrated_at") @db.Timestamptz(3)
  notes             String?
  version           Int            @default(0)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  classroom    Classroom                @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  measurements CalibrationMeasurement[]
  sightings    BeaconSighting[]
  snapshots    BeaconHealthSnapshot[]

  @@unique([protocol, identifier])
  @@index([classroomId])
  @@map("beacons")
}

/// One walk around a room with several phones (§3). Kept as recorded; applying it sets the thresholds.
model CalibrationSurvey {
  id           String    @id @default(uuid(7)) @db.Uuid
  classroomId  String    @map("classroom_id") @db.Uuid
  surveyedById String    @map("surveyed_by_id") @db.Uuid
  surveyedAt   DateTime  @map("surveyed_at") @db.Timestamptz(3)
  notes        String?
  /// The computed result per beacon (threshold, or why none), stored with the survey.
  result       Json
  appliedAt    DateTime? @map("applied_at") @db.Timestamptz(3)
  appliedById  String?   @map("applied_by_id") @db.Uuid

  classroom    Classroom                @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  surveyedBy   User                     @relation("SurveyedBy", fields: [surveyedById], references: [id], onDelete: Restrict)
  appliedBy    User?                    @relation("SurveyAppliedBy", fields: [appliedById], references: [id], onDelete: Restrict)
  measurements CalibrationMeasurement[]

  @@index([classroomId, surveyedAt])
  @@map("calibration_surveys")
}

model CalibrationMeasurement {
  id         String         @id @default(uuid(7)) @db.Uuid
  surveyId   String         @map("survey_id") @db.Uuid
  beaconId   String         @map("beacon_id") @db.Uuid
  phoneModel String         @map("phone_model")
  platform   DevicePlatform
  position   SurveyPosition
  /// Signal strength in dBm (negative; closer to 0 is stronger).
  rssi       Int

  survey CalibrationSurvey @relation(fields: [surveyId], references: [id], onDelete: Restrict)
  beacon Beacon            @relation(fields: [beaconId], references: [id], onDelete: Restrict)

  @@index([surveyId])
  @@index([beaconId])
  @@map("calibration_measurements")
}

enum ObservationBluetooth {
  ON
  OFF
  DENIED
}

enum ObservationGps {
  INSIDE
  OUTSIDE
  UNCERTAIN
  MOCKED
}

/// What one phone reported while checking in to a room (Phase 4 step 5): the beacons it heard and its
/// location result. Kept as reported (append-only); beacon health and its warnings are worked out from
/// these. Written by check-in (Phase 5); "Check this classroom" records nothing.
model BeaconObservation {
  id             String               @id @default(uuid(7)) @db.Uuid
  classroomId    String               @map("classroom_id") @db.Uuid
  /// The class running in that room at the time, if any.
  classSessionId String?              @map("class_session_id") @db.Uuid
  deviceId       String               @map("device_id") @db.Uuid
  observedAt     DateTime             @map("observed_at") @db.Timestamptz(3)
  bluetooth      ObservationBluetooth
  gps            ObservationGps
  /// Raw coordinates, for the "same beacon in two places" check. Reduced after 30 days (D-18).
  latitude       Float?
  longitude      Float?
  accuracyM      Int?                 @map("accuracy_m")

  classroom Classroom        @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  device    UserDevice       @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  sightings BeaconSighting[]

  @@index([classroomId, observedAt])
  @@index([observedAt])
  @@map("beacon_observations")
}

/// One registered beacon heard in an observation, at its strongest reading.
model BeaconSighting {
  id            String   @id @default(uuid(7)) @db.Uuid
  observationId String   @map("observation_id") @db.Uuid
  beaconId      String   @map("beacon_id") @db.Uuid
  rssi          Int
  /// Copied from the observation, so health can be summarised per beacon and time without a join.
  observedAt    DateTime @map("observed_at") @db.Timestamptz(3)

  observation BeaconObservation @relation(fields: [observationId], references: [id], onDelete: Restrict)
  beacon      Beacon            @relation(fields: [beaconId], references: [id], onDelete: Restrict)

  @@unique([observationId, beaconId])
  @@index([beaconId, observedAt])
  @@map("beacon_sightings")
}

/// A beacon's health in one 5-minute window, summarised from sightings (recomputed if re-run).
model BeaconHealthSnapshot {
  id              String   @id @default(uuid(7)) @db.Uuid
  beaconId        String   @map("beacon_id") @db.Uuid
  windowStart     DateTime @map("window_start") @db.Timestamptz(3)
  sightings       Int
  distinctDevices Int      @map("distinct_devices")
  medianRssi      Int?     @map("median_rssi")

  beacon Beacon @relation(fields: [beaconId], references: [id], onDelete: Restrict)

  @@unique([beaconId, windowStart])
  @@map("beacon_health_snapshots")
}

enum AttendanceSessionStatus {
  OPEN
  CLOSED
}

enum AttendanceCloseReason {
  /// The lecturer closed it.
  MANUAL
  /// Its closing time passed.
  AUTO
  /// The class ended (or was interrupted and ended) while attendance was open.
  CLASS_ENDED
  /// The class was voided after attendance started: every record is VOIDED.
  CLASS_VOIDED
  /// An administrator closed it.
  FORCED
}

enum AttendanceStatus {
  PRESENT
  LATE
  PENDING
  UNDER_REVIEW
  REJECTED
  ABSENT
  EXCUSED
  VOIDED
}

enum RecordSource {
  CHECK_IN
  ASSISTED
  /// Created as ABSENT when attendance closed.
  CLOSE
}

enum CorrectionSource {
  LECTURER
  ADMINISTRATOR
  REVIEW
  DISPUTE
  EXCUSE
  VOID
}

/// Attendance taken for one class meeting (ATTENDANCE_FLOW.md §1). At most one per class session.
/// The QR secret is per session, encrypted, and never sent to any device (PRESENCE_VERIFICATION §2).
model AttendanceSession {
  id                        String                  @id @default(uuid(7)) @db.Uuid
  classSessionId            String                  @unique @map("class_session_id") @db.Uuid
  status                    AttendanceSessionStatus @default(OPEN)
  openedById                String                  @map("opened_by_id") @db.Uuid
  openedAt                  DateTime                @map("opened_at") @db.Timestamptz(3)
  /// A verified check-in received after this is LATE.
  lateAfter                 DateTime                @map("late_after") @db.Timestamptz(3)
  closesAt                  DateTime                @map("closes_at") @db.Timestamptz(3)
  closedAt                  DateTime?               @map("closed_at") @db.Timestamptz(3)
  closedById                String?                 @map("closed_by_id") @db.Uuid
  closeReason               AttendanceCloseReason?  @map("close_reason")
  /// Reopened once at most, with a reason.
  reopenedAt                DateTime?               @map("reopened_at") @db.Timestamptz(3)
  qrSecretEnc               String                  @map("qr_secret_enc")
  qrRotationSeconds         Int                     @map("qr_rotation_seconds")
  /// The verification policy version in force when attendance opened (0 = the defaults).
  verificationPolicyVersion Int                     @map("verification_policy_version")
  version                   Int                     @default(0)
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  classSession ClassSession        @relation(fields: [classSessionId], references: [id], onDelete: Restrict)
  openedBy     User                @relation("AttendanceOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  closedBy     User?               @relation("AttendanceClosedBy", fields: [closedById], references: [id], onDelete: Restrict)
  records      AttendanceRecord[]
  attempts     AttendanceAttempt[]

  @@index([status, closesAt])
  @@map("attendance_sessions")
}

/// One student's attendance for one class meeting: at most one (unique), and it only moves up
/// (ATTENDANCE_FLOW.md §4). Any later change is an AttendanceCorrection with a reason.
model AttendanceRecord {
  id                  String           @id @default(uuid(7)) @db.Uuid
  classSessionId      String           @map("class_session_id") @db.Uuid
  attendanceSessionId String           @map("attendance_session_id") @db.Uuid
  studentId           String           @map("student_id") @db.Uuid
  status              AttendanceStatus
  source              RecordSource
  /// Server receipt time of the check-in that counted.
  /// The check-in attempt that set the current status, if one did.
  attemptId           String?          @map("attempt_id") @db.Uuid
  checkedInAt         DateTime?        @map("checked_in_at") @db.Timestamptz(3)
  version             Int              @default(0)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  classSession      ClassSession           @relation(fields: [classSessionId], references: [id], onDelete: Restrict)
  attendanceSession AttendanceSession      @relation(fields: [attendanceSessionId], references: [id], onDelete: Restrict)
  student           StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  attempt           AttendanceAttempt?     @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  corrections       AttendanceCorrection[]

  @@unique([classSessionId, studentId])
  @@index([studentId, status])
  @@index([attendanceSessionId, status])
  @@map("attendance_records")
}

/// Every change to a record after it was created, with why and who (append-only, CLAUDE.md rule 5).
model AttendanceCorrection {
  id            String           @id @default(uuid(7)) @db.Uuid
  recordId      String           @map("record_id") @db.Uuid
  fromStatus    AttendanceStatus @map("from_status")
  toStatus      AttendanceStatus @map("to_status")
  reason        String
  source        CorrectionSource
  /// The dispute, excuse or review that caused it, if any.
  sourceId      String?          @map("source_id") @db.Uuid
  correctedById String?          @map("corrected_by_id") @db.Uuid
  correctedAt   DateTime         @map("corrected_at") @db.Timestamptz(3)

  record      AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Restrict)
  correctedBy User?            @relation("AttendanceCorrectedBy", fields: [correctedById], references: [id], onDelete: Restrict)

  @@index([recordId, correctedAt])
  @@map("attendance_corrections")
}

enum VerificationOutcome {
  VERIFIED
  PENDING_VERIFICATION
  MANUAL_REVIEW_REQUIRED
  REJECTED
}

enum DeciderType {
  ENGINE
  LECTURER
  ADMINISTRATOR
}

/// Every check-in try, including rejected ones (ATTENDANCE_FLOW.md §2), kept as received. `receivedAt`
/// is server time, the only time that counts. The response is stored so a repeated request (same
/// idempotency key) gets the same answer.
model AttendanceAttempt {
  id                  String              @id @default(uuid(7)) @db.Uuid
  attendanceSessionId String              @map("attendance_session_id") @db.Uuid
  studentId           String              @map("student_id") @db.Uuid
  deviceId            String              @map("device_id") @db.Uuid
  idempotencyKey      String              @map("idempotency_key") @db.Uuid
  receivedAt          DateTime            @map("received_at") @db.Timestamptz(3)
  /// The QR rotation window scanned, when the token was valid.
  qrWindow            Int?                @map("qr_window")
  /// Accepted within the offline grace after its QR window: at most PENDING_VERIFICATION.
  delayedUpload       Boolean             @default(false) @map("delayed_upload")
  outcome             VerificationOutcome
  reason              String?
  retryAllowed        Boolean             @map("retry_allowed")
  canAskForReview     Boolean             @map("can_ask_for_review")
  /// What the evidence was: Bluetooth result and strongest signal, location result and distance, device, integrity, degraded mode.
  evidence            Json
  policyVersion       Int                 @map("policy_version")
  /// The answer the student got (replayed for a repeated idempotency key).
  response            Json
  appVersion          String?             @map("app_version")

  attendanceSession AttendanceSession      @relation(fields: [attendanceSessionId], references: [id], onDelete: Restrict)
  student           StudentProfile         @relation(fields: [studentId], references: [id], onDelete: Restrict)
  device            UserDevice             @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  decisions         VerificationDecision[]
  records           AttendanceRecord[]

  @@unique([studentId, idempotencyKey])
  @@index([attendanceSessionId, studentId])
  @@index([attendanceSessionId, outcome])
  @@index([deviceId, receivedAt])
  @@map("attendance_attempts")
}

/// The engine's decision on an attempt with its full rule trace, then any reviewer's decision
/// (append-only), so every outcome can be explained in a dispute.
model VerificationDecision {
  id            String              @id @default(uuid(7)) @db.Uuid
  attemptId     String              @map("attempt_id") @db.Uuid
  outcome       VerificationOutcome
  decidedBy     DeciderType         @map("decided_by")
  decidedById   String?             @map("decided_by_id") @db.Uuid
  policyVersion Int                 @map("policy_version")
  ruleTrace     Json                @map("rule_trace")
  note          String?
  decidedAt     DateTime            @map("decided_at") @db.Timestamptz(3)

  attempt       AttendanceAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  decidedByUser User?             @relation("VerificationDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  @@index([attemptId, decidedAt])
  @@map("verification_decisions")
}
