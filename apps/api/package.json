{
  "name": "@attendsure/api",
  "version": "0.0.0",
  "private": true,
  "description": "AttendSure REST API, realtime gateway and background worker",
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "nest start --watch",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node dist/database/seed.js",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.0",
    "@swc/core": "1.16.22",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "unplugin-swc": "2.0.0"
  },
  "dependencies": {
    "@attendsure/shared": "0.0.0",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/terminus": "12.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  }
}
