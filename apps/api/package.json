{
  "name": "@attendsure/api",
  "version": "0.0.0",
  "private": true,
  "description": "AttendSure REST API, realtime gateway and background worker",
  "type": "module",
  "scripts": {
    "prisma:generate": "prisma generate",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "dev": "nest start --watch",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node dist/database/seed.js",
    "db:drift": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "admin:create-super-admin": "node dist/cli/create-super-admin.js"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.12",
    "@nestjs/testing": "12.4.0",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "pino-pretty": "13.2.0",
    "prisma": "7.10.1",
    "socket.io-client": "4.8.4",
    "supertest": "7.3.2",
    "unplugin-swc": "2.0.0"
  },
  "dependencies": {
    "@attendsure/shared": "0.0.0",
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "@nestjs/platform-socket.io": "12.4.0",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/websockets": "12.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@socket.io/redis-adapter": "8.3.0",
    "argon2": "0.45.2",
    "bullmq": "6.4.2",
    "cookie-parser": "1.4.7",
    "csv-parse": "7.0.3",
    "csv-stringify": "6.9.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jose": "6.2.15",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.4.0",
    "otplib": "13.6.0",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "read-excel-file": "9.3.12",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "write-excel-file": "4.1.1",
    "zod": "4.6.7"
  }
}
