# Copy this file to .env for local development: copy .env.example .env
# These values are for your own computer only. Production secrets live in the host's secret manager.

# PostgreSQL (infra/docker-compose.yml)
POSTGRES_USER=attendsure
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=attendsure
DATABASE_URL=postgresql://attendsure:change-me-local-only@localhost:5432/attendsure

# Redis
REDIS_PASSWORD=change-me-local-only
REDIS_URL=redis://:change-me-local-only@localhost:6379

# S3-compatible storage (must match infra/seaweedfs/s3.json)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=local-dev-access-key
S3_SECRET_KEY=local-dev-secret-key-not-for-production
S3_BUCKET=attendsure-local

# Email (Mailpit catches everything)
SMTP_HOST=localhost
SMTP_PORT=1025

# Institution
INSTITUTION_TIMEZONE=Africa/Accra
