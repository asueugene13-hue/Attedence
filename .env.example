# Copy this file to .env for local development: copy .env.example .env
# These values are for your own computer only. Production secrets live in the host's secret manager.

# PostgreSQL (infra/docker-compose.yml)
POSTGRES_USER=attendsure
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=attendsure
DATABASE_URL=postgresql://attendsure:change-me-local-only@localhost:5432/attendsure

# Redis
REDIS_PASSWORD=change-me-local-only
REDIS_URL=redis://:change-me-local-only@localhost:6379

# Background jobs (emails, class monitoring). Production runs them in the separate worker
# (npm run start:worker -w @attendsure/api). For local development the API can run them itself:
RUN_JOBS_IN_API=true

# S3-compatible storage (must match infra/seaweedfs/s3.json)
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=local-dev-access-key
S3_SECRET_KEY=local-dev-secret-key-not-for-production
S3_BUCKET=attendsure-local
# Optional: the address browsers use for download links, when it differs from S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=https://files.example.edu.gh

# Email (Mailpit catches everything locally: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=AttendSure (local) <no-reply@localhost>

# Sign-in and encryption. These example values only work outside production: the API refuses to start
# in production while they contain "local-dev". Generate real ones with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   (JWT_ACCESS_SECRET)
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"      (ENCRYPTION_KEY)
JWT_ACCESS_SECRET=local-dev-only-jwt-secret-change-me-in-production-0001
ENCRYPTION_KEY=bG9jYWwtZGV2LW9ubHkta2V5LW5vdC1mb3ItcHJvZCE=

# Web dashboard address (email links; the only origin allowed to use the sign-in cookie)
WEB_APP_URL=http://localhost:3001

# Reverse proxies in front of the API (0 locally; set to the number of load balancers in production)
TRUST_PROXY_HOPS=0

# Institution
INSTITUTION_TIMEZONE=Africa/Accra
